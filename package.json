    "expo": "~58.0.14",
    "expo-audio": "~58.0.9",
    "expo-blur": "~58.0.4",
    "expo-constants": "~58.0.12",
    "expo-font": "~58.0.8",
    "expo-keep-awake": "~58.0.3",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
